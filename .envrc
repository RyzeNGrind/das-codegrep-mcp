# .envrc — direnv environment for das-codegrep-mcp
# DO NOT put real tokens here. Use agenix or pass the env var from your shell.
#
# Real token is loaded from /run/agenix/github-pat by the devshell shellHook.
# For manual local use without agenix, export in your shell before entering:
#   export DAS_GH_TOKEN="$(cat /run/agenix/github-pat)"
# or add to ~/.zshenv / ~/.bashrc (never commit that file).

export DAS_GH_TOKEN=""
export DAS_GH_USER="RyzeNGrind"
export DAS_WORKSPACE="${HOME}/Workspaces"
export ZOEKT_PORT="6070"
